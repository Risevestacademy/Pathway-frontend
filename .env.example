VITE_API_BASE_URL=
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=https://us.i.posthog.com

VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
# Set to "true" only to smoke-test Sentry against a local dev server.
VITE_SENTRY_ENABLE_DEV=



# Google Identity Services OAuth client ID (used by "Continue with Google")
VITE_GOOGLE_CLIENT_ID=

# The admin seeded on the team list until the backend can list users and roles.
# Leave empty to seed nobody.
VITE_ADMIN_OWNER_EMAIL=
VITE_ADMIN_OWNER_NAME=
